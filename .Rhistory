library(dplyr)
casen <- read.csv("data/raw/casen_reducido.csv") # desde la raíz del proyecto
ingresos <- read.csv("data/raw/casen_ingresos.csv") # base de apoyo (punto 2b)
str(casen)
dim(casen)
summary(casen$ingreso)
sum(is.na(casen$ingreso))  # cantidad de NA°s
dim(casen
dim(casen)
